<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CobaltumOrm.Tool</RootNamespace>
    <AssemblyName>CobaltumOrm.Tool</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cobaltum</ToolCommandName>
    <PackageId>CobaltumOrm.Tool</PackageId>
    <IsPackable>true</IsPackable>
    <Authors>CobaltumORM contributors</Authors>
    <Description>Command-line migration management and explicit C# code generation for CobaltumORM.</Description>
    <PackageOutputPath>../../.packages</PackageOutputPath>
    <RollForward>Major</RollForward>
    <DefineConstants>$(DefineConstants);COBALTUM_COMPILER_TASK</DefineConstants>
    <NoWarn>$(NoWarn);CS1591;RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Explicit generation runs the same analysis and code writers as the source generator and
         the MSBuild transform task. The files are shared, not copied. -->
    <Compile Include="../CobaltumOrm.Analysis/*.cs" Link="Analysis/%(Filename)%(Extension)" />
    <Compile Include="../CobaltumOrm.SourceGenerator/*.cs" Link="SourceGenerator/%(Filename)%(Extension)" />
    <Compile Include="../CobaltumOrm.Compiler/Generation/*.cs" Link="Generation/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="msbuild/CobaltumOrm.Generate.targets"
                      LogicalName="CobaltumOrm.Tool.Templates.CobaltumOrm.Generate.targets" />
    <EmbeddedResource Include="../../docs/ai/quick-reference.md"
                      LogicalName="CobaltumOrm.Tool.Mcp.Resources.quick-reference.md" />
    <EmbeddedResource Include="../../docs/ai/quick-reference.ja.md"
                      LogicalName="CobaltumOrm.Tool.Mcp.Resources.quick-reference.ja.md"
                      WithCulture="false" />
    <EmbeddedResource Include="../../docs/ai/recipes.md"
                      LogicalName="CobaltumOrm.Tool.Mcp.Resources.recipes.md" />
    <EmbeddedResource Include="../../docs/ai/recipes.ja.md"
                      LogicalName="CobaltumOrm.Tool.Mcp.Resources.recipes.ja.md"
                      WithCulture="false" />
    <EmbeddedResource Include="../../docs/ai/diagnostics.md"
                      LogicalName="CobaltumOrm.Tool.Mcp.Resources.diagnostics.md" />
    <EmbeddedResource Include="../../docs/ai/diagnostics.ja.md"
                      LogicalName="CobaltumOrm.Tool.Mcp.Resources.diagnostics.ja.md"
                      WithCulture="false" />
    <EmbeddedResource Include="../../llms.txt"
                      LogicalName="CobaltumOrm.Tool.Mcp.Resources.llms.txt" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../templates/CobaltumOrm.Templates/content/CobaltumMigrations/CobaltumMigrations.csproj"
                      LogicalName="CobaltumOrm.Tool.Templates.CobaltumMigrations.csproj" />
    <EmbeddedResource Include="../../templates/CobaltumOrm.Templates/content/CobaltumMigrations/Program.cs"
                      LogicalName="CobaltumOrm.Tool.Templates.Program.cs" />
    <EmbeddedResource Include="../../templates/CobaltumOrm.Templates/content/CobaltumMigrations/appsettings.json"
                      LogicalName="CobaltumOrm.Tool.Templates.appsettings.json" />
    <EmbeddedResource Include="../../templates/CobaltumOrm.Templates/content/CobaltumMigrations/README.md"
                      LogicalName="CobaltumOrm.Tool.Templates.README.md" />
    <EmbeddedResource Include="../../templates/CobaltumOrm.Templates/content/CobaltumMigrations/Migrations/README.md"
                      LogicalName="CobaltumOrm.Tool.Templates.Migrations.README.md" />
  </ItemGroup>
</Project>
