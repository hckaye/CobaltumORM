<Project>
  <!--
    Used by "cobaltum generate". The command injects this file through
    CustomAfterMicrosoftCommonTargets and asks MSBuild for the evaluated Compile items,
    references, AdditionalFiles, migration project inputs, and compiler properties, so the
    command sees exactly what the normal build sees. It never edits the project.
  -->
  <PropertyGroup>
    <CobaltumOrmAnalysisCache Condition="'$(CobaltumOrmAnalysisCache)' == ''">true</CobaltumOrmAnalysisCache>
  </PropertyGroup>

  <Target Name="CobaltumOrmWriteGenerationInputs" DependsOnTargets="ResolveReferences">
    <PropertyGroup>
      <CobaltumOrmIntermediateOutputPath Condition="'$(CobaltumOrmIntermediateOutputPath)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'CobaltumOrm'))</CobaltumOrmIntermediateOutputPath>
      <_CobaltumOrmAnalysisCacheDirectory>$([MSBuild]::NormalizePath('$(CobaltumOrmIntermediateOutputPath)', 'AnalysisCache'))</_CobaltumOrmAnalysisCacheDirectory>
    </PropertyGroup>
    <Error Condition="'$(CobaltumOrmGenerationInputsFile)' == ''"
           Text="CobaltumOrmGenerationInputsFile must be set when running CobaltumOrmWriteGenerationInputs." />

    <MSBuild Condition="'@(CobaltumOrmMigrationProjectReference)' != ''"
             Projects="@(CobaltumOrmMigrationProjectReference)"
             Targets="CobaltumOrmGetMigrationInputs"
             BuildInParallel="true"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_CobaltumOrmGenerateMigrationInput" />
    </MSBuild>

    <ItemGroup>
      <_CobaltumOrmGeneratePackageReference Include="@(PackageReference)"
                                           Condition="'%(PackageReference.Identity)' == 'CobaltumOrm' or $([System.String]::Copy('%(PackageReference.Identity)').ToLowerInvariant().StartsWith('cobaltumorm.'))" />
      <_CobaltumOrmGenerateCentralPackageVersion Include="@(PackageVersion)"
                                                 Condition="'%(PackageVersion.Identity)' == 'CobaltumOrm' or $([System.String]::Copy('%(PackageVersion.Identity)').ToLowerInvariant().StartsWith('cobaltumorm.'))" />
      <_CobaltumOrmGenerateSourceGenerator Include="@(Analyzer)"
                                             Condition="'%(Analyzer.Filename)' == 'CobaltumOrm.SourceGenerator'" />
      <_CobaltumOrmGenerateMigrationSource Include="@(_CobaltumOrmGenerateMigrationInput)"
                                           Condition="'%(CobaltumOrmInputKind)' == 'CSharp' and Exists('%(FullPath)')" />
      <_CobaltumOrmGenerateMigrationSql Include="@(_CobaltumOrmGenerateMigrationInput)"
                                        Condition="'%(CobaltumOrmInputKind)' == 'Sql' and Exists('%(FullPath)')" />
      <_CobaltumOrmGenerateAdditionalFile Include="@(AdditionalFiles);@(_CobaltumOrmGenerateMigrationSource);@(_CobaltumOrmGenerateMigrationSql)" />
      <_CobaltumOrmGenerateCompile Include="@(Compile)"
                                   Condition="'%(Compile.Extension)' == '.cs' and '%(Compile.AutoGen)' != 'true' and '%(Compile.DesignTime)' != 'true' and '%(Compile.CobaltumOrmTransformed)' != 'true'" />
    </ItemGroup>

    <ItemGroup>
      <_CobaltumOrmGenerationLine Include="project=$(MSBuildProjectFullPath)" />
      <_CobaltumOrmGenerationLine Include="projectdirectory=$(MSBuildProjectDirectory)" />
      <_CobaltumOrmGenerationLine Include="targetframework=$(TargetFramework)" />
      <_CobaltumOrmGenerationLine Include="configuration=$(Configuration)" />
      <_CobaltumOrmGenerationLine Include="assemblyname=$(AssemblyName)" />
      <_CobaltumOrmGenerationLine Include="rootnamespace=$(RootNamespace)" />
      <_CobaltumOrmGenerationLine Include="intermediateoutputpath=$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)'))" />
      <_CobaltumOrmGenerationLine Include="langversion=$(LangVersion)" />
      <_CobaltumOrmGenerationLine Include="nullable=$(Nullable)" />
      <_CobaltumOrmGenerationLine Include="implicitusings=$(ImplicitUsings)" />
      <_CobaltumOrmGenerationLine Include="defineconstants=$([MSBuild]::Escape('$(DefineConstants)'))" />
      <_CobaltumOrmGenerationLine Include="databaseprovider=$(CobaltumOrmDatabaseProvider)" />
      <_CobaltumOrmGenerationLine Include="generatednamespace=$(CobaltumOrmGeneratedNamespace)" />
      <_CobaltumOrmGenerationLine Include="analysiscache=$(CobaltumOrmAnalysisCache)" />
      <_CobaltumOrmGenerationLine Include="analysiscachedirectory=$(_CobaltumOrmAnalysisCacheDirectory)" />
      <_CobaltumOrmGenerationLine Include="compilertaskassembly=$(CobaltumOrmCompilerTaskAssembly)" />
      <_CobaltumOrmGenerationLine Include="compiletimequeries=$(CobaltumOrmCompileTimeQueries)" />
      <_CobaltumOrmGenerationLine Include="@(_CobaltumOrmGenerateCompile->'compile=%(FullPath)')" />
      <_CobaltumOrmGenerationLine Include="@(ReferencePath->'reference=%(FullPath)')" />
      <_CobaltumOrmGenerationLine Include="@(_CobaltumOrmGenerateAdditionalFile->'additionalfile=%(FullPath)')" />
      <_CobaltumOrmGenerationLine Include="@(_CobaltumOrmGenerateMigrationSource->'migrationsource=%(FullPath)')" />
      <_CobaltumOrmGenerationLine Include="@(_CobaltumOrmGeneratePackageReference->'cobaltumormpackagereference=%(Identity)|%(VersionOverride)|%(Version)')" />
      <_CobaltumOrmGenerationLine Include="@(_CobaltumOrmGenerateCentralPackageVersion->'cobaltumormcentralpackageversion=%(Identity)|%(Version)')" />
      <_CobaltumOrmGenerationLine Include="@(CobaltumOrmMigrationProjectReference->'migrationprojectreference=%(FullPath)')" />
      <_CobaltumOrmGenerationLine Include="@(_CobaltumOrmGenerateSourceGenerator->'sourcegenerator=%(FullPath)')" />
      <_CobaltumOrmGenerationLine Include="@(CompilerVisibleProperty->'compilervisibleproperty=%(Identity)')" />
      <_CobaltumOrmGenerationLine Include="@(_CobaltumOrmGenerateMigrationSource->'migrationinput=%(FullPath)')" />
      <_CobaltumOrmGenerationLine Include="@(_CobaltumOrmGenerateMigrationSql->'migrationinput=%(FullPath)')" />
    </ItemGroup>

    <WriteLinesToFile File="$(CobaltumOrmGenerationInputsFile)"
                      Lines="@(_CobaltumOrmGenerationLine)"
                      Overwrite="true" />
  </Target>
</Project>
