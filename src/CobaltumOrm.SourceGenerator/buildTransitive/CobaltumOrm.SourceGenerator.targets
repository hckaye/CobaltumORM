<Project>
  <PropertyGroup>
    <_CobaltumOrmDatabaseProviderWasExplicit Condition="'$(CobaltumOrmDatabaseProvider)' != ''">true</_CobaltumOrmDatabaseProviderWasExplicit>
    <CobaltumOrmDatabaseProvider Condition="'$(CobaltumOrmDatabaseProvider)' == ''">PostgreSql</CobaltumOrmDatabaseProvider>
    <CobaltumOrmAnalysisCache Condition="'$(CobaltumOrmAnalysisCache)' == ''">true</CobaltumOrmAnalysisCache>
    <!-- Migration projects define migrations, not compile-time queries. Skip the
         compiler transform targets so a migration project built as a ProjectReference
         does not require the compiler task assembly. -->
    <CobaltumOrmCompileTimeQueries Condition="'$(CobaltumOrmMigrationProject)' == 'true'">false</CobaltumOrmCompileTimeQueries>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="CobaltumOrmDatabaseProvider" />
    <CompilerVisibleProperty Include="CobaltumOrmAnalysisCache" />
    <CompilerVisibleProperty Include="_CobaltumOrmAnalysisCacheDirectory" />
  </ItemGroup>

  <!--
    A migration project reference supplies migration inputs to the build and also references
    the migration assembly, so runtime types such as CobaltumMigrationCatalog are available
    to the application. The reference stays private to this project. A ProjectReference that
    already points at the same project is not duplicated.
  -->
  <ItemGroup Condition="'@(CobaltumOrmMigrationProjectReference)' != ''">
    <ProjectReference Include="@(CobaltumOrmMigrationProjectReference)"
                      Exclude="@(ProjectReference)"
                      PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <CobaltumOrmCompilerTaskAssembly Condition="'$(CobaltumOrmCompilerTaskAssembly)' == ''">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'tools', 'netstandard2.0', 'CobaltumOrm.Compiler.dll'))</CobaltumOrmCompilerTaskAssembly>
  </PropertyGroup>

  <UsingTask TaskName="CobaltumOrm.Compiler.CobaltumOrmTransformTask"
             AssemblyFile="$(CobaltumOrmCompilerTaskAssembly)" />
  <UsingTask TaskName="CobaltumOrm.Compiler.CobaltumOrmCollectTransformInputsTask"
             AssemblyFile="$(CobaltumOrmCompilerTaskAssembly)" />
  <UsingTask TaskName="CobaltumOrm.Compiler.CobaltumOrmReadTransformManifestTask"
             AssemblyFile="$(CobaltumOrmCompilerTaskAssembly)" />

  <Target Name="CobaltumOrmConfigureAnalysisCache"
          BeforeTargets="GenerateMSBuildEditorConfigFileCore;CobaltumOrmCollectTransformInputs">
    <PropertyGroup>
      <CobaltumOrmIntermediateOutputPath Condition="'$(CobaltumOrmIntermediateOutputPath)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'CobaltumOrm'))</CobaltumOrmIntermediateOutputPath>
      <_CobaltumOrmAnalysisCacheDirectory>$([MSBuild]::NormalizePath('$(CobaltumOrmIntermediateOutputPath)', 'AnalysisCache'))</_CobaltumOrmAnalysisCacheDirectory>
    </PropertyGroup>
  </Target>

  <Target Name="CobaltumOrmCleanAnalysisCache"
          BeforeTargets="CoreClean"
          DependsOnTargets="CobaltumOrmConfigureAnalysisCache">
    <ItemGroup>
      <Clean Include="$(_CobaltumOrmAnalysisCacheDirectory)/schema-*.xml" />
      <Clean Include="$(_CobaltumOrmAnalysisCacheDirectory)/query-*.xml" />
      <Clean Include="$(_CobaltumOrmAnalysisCacheDirectory)/*.tmp" />
    </ItemGroup>
  </Target>

  <Target Name="CobaltumOrmGetMigrationInputs"
          Returns="@(_CobaltumOrmMigrationInput)">
    <Error Condition="'$(CobaltumOrmMigrationProject)' != 'true'"
           Text="Project '$(MSBuildProjectFullPath)' must set CobaltumOrmMigrationProject to true before it can be used as a CobaltumOrmMigrationProjectReference." />
    <ItemGroup>
      <_CobaltumOrmMigrationInput Include="$(MSBuildProjectDirectory)/Migrations/**/*.cs">
        <CobaltumOrmInputKind>CSharp</CobaltumOrmInputKind>
        <CobaltumOrmDatabaseProvider>$(CobaltumOrmDatabaseProvider)</CobaltumOrmDatabaseProvider>
      </_CobaltumOrmMigrationInput>
      <_CobaltumOrmMigrationInput Include="$(MSBuildProjectDirectory)/Migrations/V*__*.sql">
        <CobaltumOrmInputKind>Sql</CobaltumOrmInputKind>
        <CobaltumOrmDatabaseProvider>$(CobaltumOrmDatabaseProvider)</CobaltumOrmDatabaseProvider>
      </_CobaltumOrmMigrationInput>
    </ItemGroup>
  </Target>

  <Target Name="CobaltumOrmResolveMigrationProjectInputs"
          Condition="'@(CobaltumOrmMigrationProjectReference)' != ''">
    <MSBuild Projects="@(CobaltumOrmMigrationProjectReference)"
             Targets="CobaltumOrmGetMigrationInputs"
             BuildInParallel="true"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_CobaltumOrmMigrationProjectInput" />
    </MSBuild>
    <ItemGroup>
      <_CobaltumOrmExternalMigrationProvider Include="@(_CobaltumOrmMigrationProjectInput->'%(CobaltumOrmDatabaseProvider)')"
                                                   Condition="'%(CobaltumOrmDatabaseProvider)' != ''" />
      <_CobaltumOrmExternalMigrationSource Include="@(_CobaltumOrmMigrationProjectInput)"
                                           Condition="'%(CobaltumOrmInputKind)' == 'CSharp' and Exists('%(FullPath)')" />
      <_CobaltumOrmExternalMigrationSql Include="@(_CobaltumOrmMigrationProjectInput)"
                                        Condition="'%(CobaltumOrmInputKind)' == 'Sql' and Exists('%(FullPath)')" />
      <AdditionalFiles Include="@(_CobaltumOrmExternalMigrationSource);@(_CobaltumOrmExternalMigrationSql)" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_CobaltumOrmExternalMigrationProvider)">
      <Output TaskParameter="Filtered" ItemName="_CobaltumOrmDistinctExternalMigrationProvider" />
    </RemoveDuplicates>
    <PropertyGroup>
      <_CobaltumOrmExternalMigrationProviders>@(_CobaltumOrmDistinctExternalMigrationProvider)</_CobaltumOrmExternalMigrationProviders>
      <CobaltumOrmDatabaseProvider Condition="'$(_CobaltumOrmDatabaseProviderWasExplicit)' != 'true' and '$(_CobaltumOrmExternalMigrationProviders)' != ''">$(_CobaltumOrmExternalMigrationProviders)</CobaltumOrmDatabaseProvider>
    </PropertyGroup>
    <Error Condition="$([System.String]::Copy('$(_CobaltumOrmExternalMigrationProviders)').Contains(';'))"
           Text="CobaltumOrmMigrationProjectReference projects must use one database provider." />
  </Target>

  <Target Name="CobaltumOrmCollectTransformInputs"
          DependsOnTargets="ResolveReferences;CobaltumOrmResolveMigrationProjectInputs;CobaltumOrmConfigureAnalysisCache"
          Condition="'$(CobaltumOrmCompileTimeQueries)' != 'false'">
    <PropertyGroup>
      <CobaltumOrmIntermediateOutputPath Condition="'$(CobaltumOrmIntermediateOutputPath)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'CobaltumOrm'))</CobaltumOrmIntermediateOutputPath>
      <CobaltumOrmTransformInputManifest>$([MSBuild]::NormalizePath('$(CobaltumOrmIntermediateOutputPath)', 'CobaltumOrm.TransformInputs.xml'))</CobaltumOrmTransformInputManifest>
      <CobaltumOrmTransformSuccessManifest>$([MSBuild]::NormalizePath('$(CobaltumOrmIntermediateOutputPath)', 'CobaltumOrm.TransformSuccess.xml'))</CobaltumOrmTransformSuccessManifest>
    </PropertyGroup>
    <ItemGroup>
      <_CobaltumOrmInputSource Include="@(Compile)"
                               Condition="'%(Compile.Extension)' == '.cs' and '%(Compile.AutoGen)' != 'true' and '%(Compile.DesignTime)' != 'true' and '%(Compile.CobaltumOrmTransformed)' != 'true'" />
    </ItemGroup>

    <CobaltumOrmCollectTransformInputsTask Sources="@(_CobaltumOrmInputSource)"
                                           MigrationSources="@(_CobaltumOrmExternalMigrationSource)"
                                           References="@(ReferencePath)"
                                           AdditionalFiles="@(AdditionalFiles)"
                                           InputManifestPath="$(CobaltumOrmTransformInputManifest)"
                                           SuccessManifestPath="$(CobaltumOrmTransformSuccessManifest)"
                                           OutputDirectory="$(CobaltumOrmIntermediateOutputPath)"
                                           DefineConstants="$(DefineConstants)"
                                           LangVersion="$(LangVersion)"
                                           Nullable="$(Nullable)"
                                           GeneratedNamespace="$(CobaltumOrmGeneratedNamespace)"
                                           CobaltumOrmDatabaseProvider="$(CobaltumOrmDatabaseProvider)"
                                           CobaltumOrmAnalysisCache="$(CobaltumOrmAnalysisCache)"
                                           AnalysisCacheDirectory="$(_CobaltumOrmAnalysisCacheDirectory)"
                                           CobaltumOrmCompileTimeQueries="$(CobaltumOrmCompileTimeQueries)"
                                           ProjectPath="$(MSBuildProjectFullPath)"
                                           TaskAssemblyPath="$(CobaltumOrmCompilerTaskAssembly)">
      <Output TaskParameter="InputFiles" ItemName="_CobaltumOrmTransformInputFile" />
      <Output TaskParameter="CachedOutputs" ItemName="_CobaltumOrmCachedTransformOutput" />
    </CobaltumOrmCollectTransformInputsTask>

    <ItemGroup>
      <FileWrites Include="$(CobaltumOrmTransformInputManifest)" />
      <FileWrites Include="@(_CobaltumOrmCachedTransformOutput)" />
    </ItemGroup>
  </Target>

  <Target Name="CobaltumOrmRunTransform"
          DependsOnTargets="CobaltumOrmCollectTransformInputs"
          Inputs="$(CobaltumOrmTransformInputManifest);$(CobaltumOrmCompilerTaskAssembly)"
          Outputs="$(CobaltumOrmTransformSuccessManifest)"
          Condition="'$(CobaltumOrmCompileTimeQueries)' != 'false'">
    <Delete Files="$(CobaltumOrmTransformSuccessManifest)" />

    <CobaltumOrmTransformTask Sources="@(_CobaltumOrmInputSource)"
                              MigrationSources="@(_CobaltumOrmExternalMigrationSource)"
                              References="@(ReferencePath)"
                              AdditionalFiles="@(AdditionalFiles)"
                              OutputDirectory="$(CobaltumOrmIntermediateOutputPath)"
                              SuccessManifestPath="$(CobaltumOrmTransformSuccessManifest)"
                              DefineConstants="$(DefineConstants)"
                              LangVersion="$(LangVersion)"
                              Nullable="$(Nullable)"
                              GeneratedNamespace="$(CobaltumOrmGeneratedNamespace)"
                              CobaltumOrmDatabaseProvider="$(CobaltumOrmDatabaseProvider)"
                              AnalysisCacheDirectory="$(_CobaltumOrmAnalysisCacheDirectory)"
                              AnalysisCacheEnabled="$(CobaltumOrmAnalysisCache)" />
  </Target>

  <Target Name="CobaltumOrmRestoreTransformSources"
          DependsOnTargets="CobaltumOrmRunTransform"
          Condition="'$(CobaltumOrmCompileTimeQueries)' != 'false'">
    <CobaltumOrmReadTransformManifestTask SuccessManifestPath="$(CobaltumOrmTransformSuccessManifest)">
      <Output TaskParameter="ProcessedSources" ItemName="_CobaltumOrmManifestProcessedSource" />
      <Output TaskParameter="TransformedSources" ItemName="_CobaltumOrmManifestTransformedSource" />
      <Output TaskParameter="Outputs" ItemName="_CobaltumOrmManifestOutput" />
    </CobaltumOrmReadTransformManifestTask>

    <ItemGroup>
      <Compile Remove="@(_CobaltumOrmManifestProcessedSource)" />
      <Compile Include="@(_CobaltumOrmManifestTransformedSource)" />
      <FileWrites Include="$(CobaltumOrmTransformSuccessManifest)" />
      <FileWrites Include="@(_CobaltumOrmManifestOutput)" />
    </ItemGroup>
  </Target>

  <Target Name="CobaltumOrmTransformSources"
          BeforeTargets="CoreCompile"
          DependsOnTargets="CobaltumOrmRestoreTransformSources"
          Condition="'$(CobaltumOrmCompileTimeQueries)' != 'false'" />
</Project>
